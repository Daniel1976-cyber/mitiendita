# El punto de venta usa el MISMO Supabase de tu tienda — así lee el
# catálogo real (con precios) y guarda las ventas ahí mismo.

STORE_NAME="Mi Tienda — Punto de Venta"
STORE_LOGO_PATH="/logo.png"
STORE_COLOR_PRIMARY="#0f766e"
STORE_CURRENCY_LABEL="USD"           # "USD" o "CUP" — debe coincidir con cómo esa tienda maneja sus precios

# Mismas credenciales de Supabase que ya usas en la tienda online.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE="service-role-key-aqui"

# Contraseña única para abrir el punto de venta (puede ser la misma del
# admin de la tienda, o una distinta si prefieres separarlas).
POS_PASSWORD="cambia-esta-clave"

PORT=3000
